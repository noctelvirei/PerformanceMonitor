{
  "Urls": "http://localhost:5155",
  "Monitor": {
    "StorageProvider": "DuckDb",
    "StoragePath": "data\\headless\\performance-monitor.duckdb",
    "ArchiveDirectory": "data\\headless\\parquet",
    "Repository": {
      "ConnectionMode": "Windows",
      "DataSource": "",
      "InitialCatalog": "PerformanceMonitorRepository",
      "Encrypt": "Optional",
      "TrustServerCertificate": true
    },
    "IngestApiKey": "",
    "McpAccess": {
      "Enabled": true,
      "AuthMode": "None",
      "PublicBaseUrl": "http://localhost:5155",
      "AllowLocalWithoutApiKey": false
    },
    "CollectionIntervalSeconds": 60,
    "MaxConcurrentServers": 8,
    "CommandTimeoutSeconds": 30,
    "ArchiveIntervalMinutes": 60,
    "HotDataDays": 7,
    "AlertRules": {
      "Enabled": true,
      "CpuEnabled": true,
      "CpuWarningThreshold": 80,
      "CpuCriticalThreshold": 90,
      "LongRunningQueryEnabled": true,
      "LongRunningQueryWarningMinutes": 15,
      "LongRunningQueryCriticalMinutes": 30,
      "BlockingEnabled": true,
      "DeadlockEnabled": true,
      "MemoryGrantEnabled": true,
      "MemoryGrantWarningSeconds": 5,
      "MemoryGrantCriticalSeconds": 30,
      "FileLatencyEnabled": true,
      "FileLatencyWarningMs": 50,
      "FileLatencyCriticalMs": 200,
      "LongRunningJobEnabled": true,
      "LongRunningJobWarningMinutes": 60,
      "LongRunningJobCriticalMinutes": 240
    },
    "Collectors": [
      {
        "Name": "server_properties",
        "Enabled": true,
        "FrequencySeconds": 3600
      },
      {
        "Name": "wait_stats",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "cpu_utilization",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "waiting_tasks",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "query_stats",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "procedure_stats",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "query_store",
        "Enabled": true,
        "FrequencySeconds": 300
      },
      {
        "Name": "query_snapshots",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "file_io_stats",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "memory_stats",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "memory_clerks",
        "Enabled": true,
        "FrequencySeconds": 300
      },
      {
        "Name": "memory_pressure_events",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "tempdb_stats",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "perfmon_stats",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "memory_grant_stats",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "session_stats",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "server_config",
        "Enabled": true,
        "FrequencySeconds": 0
      },
      {
        "Name": "database_config",
        "Enabled": true,
        "FrequencySeconds": 0
      },
      {
        "Name": "database_scoped_config",
        "Enabled": true,
        "FrequencySeconds": 0
      },
      {
        "Name": "trace_flags",
        "Enabled": true,
        "FrequencySeconds": 0
      },
      {
        "Name": "running_jobs",
        "Enabled": true,
        "FrequencySeconds": 300
      },
      {
        "Name": "database_size_stats",
        "Enabled": true,
        "FrequencySeconds": 300
      },
      {
        "Name": "deadlocks",
        "Enabled": true,
        "FrequencySeconds": 60
      },
      {
        "Name": "blocked_process_report",
        "Enabled": true,
        "FrequencySeconds": 60
      }
    ],
    "Servers": [
      {
        "Id": "sample-dev",
        "DisplayName": "EU4",
        "Purpose": "Development",
        "ConnectionMode": "Windows",
        "DataSource": "EU4",
        "InitialCatalog": "master",
        "Encrypt": "Optional",
        "TrustServerCertificate": true,
        "Enabled": false
      }
    ]
  }
}
